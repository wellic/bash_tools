REMOVE_COMMENTS_PATTERN='/^\s*#\|^\s*$/d'
NEWLINE_PATTERN='2,$s/^\([^[:space:]]\)/\n\1/g'
CURLY_QUOTES_PATTERN='s/(\{\{[^}]+\}\}-?[^[:space:]]*)/"\1"/g'
SINGLE_QUOTES_PATTERN='s/"(\{\{[^"]+)"/\1/g'

REMOVE_COMMENTS_PATTERN='/^\s*#\|^\s*$/d'
NEWLINE_PATTERN='2,$s/^\([^[:space:]]\)/\n\1/g'
CURLY_QUOTES_PATTERN='s/(\{\{[^}]+\}\}-?[^[:space:]]*)/"\1"/g'
SINGLE_QUOTES_PATTERN="s/'(\{\{[^']+)'/\1/g"
SEPARATE_PATTERN="s/(^---\s*)/\n\1/g"

process_yaml() {
  local in_place=$1
  local file=$2
  local sed_opt=""

  [[ $in_place == "true" ]] && sed_opt="-i.bak"

  sed $sed_opt "$REMOVE_COMMENTS_PATTERN" $file
  sed $sed_opt "$NEWLINE_PATTERN" $file
  sed $sed_opt -E "$CURLY_QUOTES_PATTERN" $file
#  yq  -i -rP $file
  yq -P $([[ $in_place == "true" ]] && echo "-i" || echo "-r") $file
  sed $sed_opt -E "$SINGLE_QUOTES_PATTERN" $file
#  sed $sed_opt -E "$SEPARATE_PATTERN" $file
}

if [[ $# -eq 0 ]]; then
  process_yaml "false" /dev/stdin
else
  process_yaml "true" "$1"
fi



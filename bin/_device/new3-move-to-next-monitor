#!/usr/bin/env python3
"""Toggle the active X11 window between two differently sized monitors.

Requires: python3, xrandr, xdotool, xwininfo, xprop, wmctrl.
Uses monitor geometry, frame extents and per-monitor panel reservations.
Keeps relative placement and remembers the preferred client size in a private
runtime directory. Concurrent shortcut invocations are ignored while moving.
"""

import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
import tempfile


@dataclass(frozen=True)
class Rect:
    x: int
    y: int
    w: int
    h: int


def run(*args):
    result = subprocess.run(args, text=True, capture_output=True, timeout=5,
                            env={**os.environ, "LC_ALL": "C"})
    if result.returncode:
        raise RuntimeError(f"{args[0]}: {result.stderr.strip() or result.stdout.strip()}")
    return result.stdout


def numbers(prop):
    return [int(n) for n in re.findall(r"-?\d+", prop.split("=", 1)[-1])] if "=" in prop else []


def intersection(a, b):
    x, y = max(a.x, b.x), max(a.y, b.y)
    return Rect(x, y, max(0, min(a.x + a.w, b.x + b.w) - x),
                max(0, min(a.y + a.h, b.y + b.h) - y))


def monitors():
    found = []
    for line in run("xrandr", "--listmonitors").splitlines():
        match = re.search(r"(\d+)/(?:\d+)x(\d+)/(?:\d+)([+-]\d+)([+-]\d+)", line)
        if match:
            w, h, x, y = map(int, match.groups())
            rect = Rect(x, y, w, h)
            if rect not in found:
                found.append(rect)
    if not found:
        raise RuntimeError("Не удалось определить геометрию мониторов.")
    return sorted(found, key=lambda r: (r.x, r.y))


def geometry(window):
    info = run("xwininfo", "-id", window)
    values = []
    for field in ("Absolute upper-left X", "Absolute upper-left Y", "Width", "Height"):
        match = re.search(r"^\s*" + field + r":\s*(-?\d+)", info, re.M)
        if not match:
            raise RuntimeError(f"Не удалось прочитать {field} окна {window}.")
        values.append(int(match.group(1)))
    extents = numbers(run("xprop", "-id", window, "_NET_FRAME_EXTENTS"))
    left, right, top, bottom = extents if len(extents) == 4 else (0, 0, 0, 0)
    x, y, w, h = values
    return Rect(x - left, y - top, w + left + right, h + top + bottom), (left, right, top, bottom)


def states(window):
    return set(re.findall(r"_NET_WM_STATE_[A-Z_]+", run("xprop", "-id", window, "_NET_WM_STATE")))


def set_state(window, action, state):
    run("wmctrl", "-ir", window, "-b", f"{action},{state}")


def wait_states(window, expected, tracked):
    for _ in range(40):
        if states(window) & tracked == expected:
            return
        time.sleep(0.05)
    raise RuntimeError("Оконный менеджер не подтвердил изменение состояния окна.")


def panel_strips(values, width, height):
    """EWMH strut distances are measured from the root window's edges.

    Partial-strut ranges are inclusive and allow a panel on just one monitor.
    Legacy four-value struts reserve the entire corresponding root edge.
    """
    left, right, top, bottom = values[:4]
    ranges = values[4:12] if len(values) == 12 else [0, height - 1, 0, height - 1,
                                                           0, width - 1, 0, width - 1]
    ly0, ly1, ry0, ry1, tx0, tx1, bx0, bx1 = ranges
    return [
        ("left", Rect(0, ly0, left, max(0, ly1 - ly0 + 1))),
        ("right", Rect(width - right, ry0, right, max(0, ry1 - ry0 + 1))),
        ("top", Rect(tx0, 0, max(0, tx1 - tx0 + 1), top)),
        ("bottom", Rect(bx0, height - bottom, max(0, bx1 - bx0 + 1), bottom)),
    ]


def subtract_panels(monitor, strips):
    # Use the original monitor for overlap checks so order cannot hide a panel.
    x0, y0 = monitor.x, monitor.y
    x1, y1 = x0 + monitor.w, y0 + monitor.h
    for edge, strip in strips:
        overlap = intersection(monitor, strip)
        if overlap.w <= 0 or overlap.h <= 0:
            continue
        if edge == "left":
            x0 = max(x0, strip.x + strip.w)
        elif edge == "right":
            x1 = min(x1, strip.x)
        elif edge == "top":
            y0 = max(y0, strip.y + strip.h)
        elif edge == "bottom":
            y1 = min(y1, strip.y)
    if x1 <= x0 or y1 <= y0:
        raise RuntimeError("Панели занимают всю рабочую область монитора.")
    return Rect(x0, y0, x1 - x0, y1 - y0)


def workareas(screens):
    desktop = numbers(run("xprop", "-root", "_NET_CURRENT_DESKTOP"))
    current = desktop[0] if desktop else 0
    root = run("xwininfo", "-root")
    width = re.search(r"^\s*Width:\s*(\d+)", root, re.M)
    height = re.search(r"^\s*Height:\s*(\d+)", root, re.M)
    if not width or not height:
        raise RuntimeError("Не удалось определить размеры X-дисплея.")
    width, height = int(width[1]), int(height[1])
    clients = re.findall(r"0x[0-9a-fA-F]+", run("xprop", "-root", "_NET_CLIENT_LIST"))
    strips = []
    has_reservations = False
    for client in clients:
        try:
            info = run("xprop", "-id", client, "_NET_WM_STRUT_PARTIAL",
                       "_NET_WM_STRUT", "_NET_WM_DESKTOP")
        except RuntimeError:
            continue  # A window may close while the client list is being read.
        props = {line.split("(", 1)[0]: numbers(line) for line in info.splitlines()}
        values = props.get("_NET_WM_STRUT_PARTIAL", [])
        if len(values) != 12:
            values = props.get("_NET_WM_STRUT", [])
        if len(values) not in (4, 12) or not any(values[:4]):
            continue
        has_reservations = True
        owner = props.get("_NET_WM_DESKTOP", [])
        if owner and owner[0] not in (current, 0xFFFFFFFF):
            continue
        strips.extend(panel_strips(values, width, height))
    if has_reservations:
        # Do not apply global _NET_WORKAREA here: many WMs subtract the top
        # panel's height from every monitor even when only one has a panel.
        return [subtract_panels(screen, strips) for screen in screens]

    # Compatibility fallback for WMs/panels not exposing EWMH struts.
    areas = numbers(run("xprop", "-root", "_NET_WORKAREA"))
    offset = 4 * current
    if len(areas) >= offset + 4:
        result = [intersection(screen, Rect(*areas[offset:offset + 4])) for screen in screens]
        return [area if area.w > 0 and area.h > 0 else screen
                for area, screen in zip(result, screens)]
    return screens


def anchor(position, size, origin, available):
    return min(1.0, max(0.0, (position - origin) / (available - size))) if available > size else 0.5


def destination(size, relative, area):
    w, h = min(size[0], area.w), min(size[1], area.h)
    x = area.x + round(relative[0] * (area.w - w))
    y = area.y + round(relative[1] * (area.h - h))
    return Rect(x, y, w, h)


def clamp(rect, area):
    w, h = min(rect.w, area.w), min(rect.h, area.h)
    return Rect(min(max(rect.x, area.x), area.x + area.w - w),
                min(max(rect.y, area.y), area.y + area.h - h), w, h)


def runtime_directory():
    base = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
    directory = base / f"new2-move-to-next-monitor-{os.getuid()}"
    directory.mkdir(mode=0o700, exist_ok=True)
    stat = directory.lstat()
    if directory.is_symlink() or not directory.is_dir() or stat.st_uid != os.getuid() or stat.st_mode & 0o077:
        raise RuntimeError(f"Небезопасные права каталога состояния: {directory}")
    return directory


def load_memory(directory):
    try:
        data = json.loads((directory / "windows.json").read_text())
        if not isinstance(data, dict):
            return {}
        return {key: value for key, value in data.items()
                if isinstance(value, dict) and isinstance(value.get("time"), (int, float))
                and time.time() - value["time"] < 7 * 86400}
    except (FileNotFoundError, ValueError):
        return {}


def save_memory(directory, data):
    with tempfile.NamedTemporaryFile(mode="w", dir=directory, delete=False) as stream:
        temporary = Path(stream.name)
        json.dump(data, stream)
    temporary.replace(directory / "windows.json")


def move(window, rect, frame):
    left, right, top, bottom = frame
    # EWMH StaticGravity: position refers to the client origin, size excludes frame.
    spec = f"10,{rect.x + left},{rect.y + top},{max(1, rect.w - left - right)},{max(1, rect.h - top - bottom)}"
    run("wmctrl", "-ir", window, "-e", spec)


def main(directory):
    missing = [cmd for cmd in ("xrandr", "xdotool", "xwininfo", "xprop", "wmctrl") if not shutil.which(cmd)]
    if missing:
        raise RuntimeError("Не установлены команды: " + ", ".join(missing))
    screens = monitors()
    if len(screens) != 2:
        raise RuntimeError("Этот скрипт рассчитан ровно на два монитора.")
    window = run("xdotool", "getactivewindow").strip()
    initial, _ = geometry(window)
    # Prefer the monitor containing most of the outer window; break ties by distance.
    def score(screen):
        overlap = intersection(initial, screen)
        distance = (initial.x + initial.w / 2 - screen.x - screen.w / 2) ** 2 + (initial.y + initial.h / 2 - screen.y - screen.h / 2) ** 2
        return overlap.w * overlap.h, -distance
    index = max(range(len(screens)), key=lambda i: score(screens[i]))
    source, target = screens[index], screens[(index + 1) % len(screens)]
    available = workareas(screens)
    source_area, area = available[index], available[(index + 1) % len(screens)]
    # PID/class/leader reduce accidental reuse of a closed window's XID.
    identity = run("xprop", "-id", window, "_NET_WM_PID", "WM_CLASS", "WM_CLIENT_LEADER")
    key = os.environ.get("DISPLAY", "") + ":" + window
    memory = load_memory(directory)
    previous = memory.get(key, {})
    if previous.get("identity") != identity:
        previous = {}
    state_names = {
        "_NET_WM_STATE_FULLSCREEN": "fullscreen",
        "_NET_WM_STATE_MAXIMIZED_VERT": "maximized_vert",
        "_NET_WM_STATE_MAXIMIZED_HORZ": "maximized_horz",
    }
    saved = states(window) & state_names.keys()
    try:
        for state in saved:
            set_state(window, "remove", state_names[state])
        if saved:
            wait_states(window, set(), state_names.keys())
            time.sleep(0.1)
        rect, frame = geometry(window)
        left, right, top, bottom = frame
        client_size = [rect.w - left - right, rect.h - top - bottom]
        relative = [anchor(rect.x, rect.w, source_area.x, source_area.w),
                    anchor(rect.y, rect.h, source_area.y, source_area.h)]
        preferred = client_size
        # Preserve original size/anchor after automatic shrinking. A manual resize
        # becomes the new preferred size; manual movement updates the anchor.
        last = previous.get("last", [])
        if len(last) == 4 and all(isinstance(v, (int, float)) for v in last):
            if all(abs(client_size[i] - last[i + 2]) <= 2 for i in range(2)):
                preferred = previous.get("preferred", client_size)
                for i, (position, available, size) in enumerate(
                        ((rect.x, source_area.w, rect.w), (rect.y, source_area.h, rect.h))):
                    if abs(position - last[i]) <= 2 or size >= available:
                        relative[i] = previous.get("relative", relative)[i]
        requested = destination((preferred[0] + left + right, preferred[1] + top + bottom), relative, area)
        move(window, requested, frame)
        # Give the WM time to apply size hints and frame geometry, then clamp again.
        time.sleep(0.15)
        actual, frame = geometry(window)
        corrected = clamp(actual, area)
        if corrected != actual:
            move(window, corrected, frame)
            time.sleep(0.15)
        actual, actual_frame = geometry(window)
        if actual.w > area.w or actual.h > area.h:
            print("Предупреждение: минимальный размер окна превышает рабочую область монитора.", file=sys.stderr)
        elif intersection(actual, area) != actual:
            raise RuntimeError("Оконный менеджер не разместил окно внутри целевого монитора.")
        al, ar, at, ab = actual_frame
        memory[key] = {"identity": identity, "preferred": preferred, "relative": relative,
                       "last": [actual.x, actual.y, actual.w - al - ar, actual.h - at - ab],
                       "time": time.time()}
        save_memory(directory, memory)
    finally:
        for state in saved:
            set_state(window, "add", state_names[state])
        if saved:
            wait_states(window, saved, state_names.keys())


def entrypoint():
    # Intentionally share the directory/lock with new2, preventing concurrent
    # moves by either version. Keep this lock held through state restoration.
    directory = runtime_directory()
    with (directory / "move.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return  # Ignore key-repeat while the previous move is in progress.
        main(directory)


if __name__ == "__main__":
    try:
        entrypoint()
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as error:
        print(f"Ошибка: {error}", file=sys.stderr)
        sys.exit(1)

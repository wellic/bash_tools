#!/usr/bin/env bash

set -euo pipefail
#set -x

SUDO=sudo
[[ "$(whoami)" == "root" ]] && SUDO=""

mask='^(enp|wlp)'
NETPLAN_DIR="/etc/netplan"
BAK_DIR="$NETPLAN_DIR/bak"
"$SUDO" mkdir -p "$BAK_DIR"

status=false
for file in "$NETPLAN_DIR"/*.yaml "$NETPLAN_DIR"/*.yml; do
    "$SUDO" yq eval '.network.ethernets.*.match.name' "$file" 2>/dev/null | grep -Eq "$mask" || continue
    echo -e "\nProcessing: $file\n"

    file_bak="$BAK_DIR/$(basename "$file")"
    "$SUDO" rm -f "$file_bak"
    "$SUDO" cp "$file" "$file_bak"

    "$SUDO" yq eval 'del(
        .network.ethernets.*.nameservers,
        .network.ethernets.*.networkmanager.passthrough."ipv4.dns-search",
        .network.ethernets.*.networkmanager.passthrough."ipv4.ignore-auto-dns",
        .network.ethernets.*.networkmanager.passthrough."ipv6.ignore-auto-dns"
    )' -i "$file" 2>/dev/null

    if "$SUDO" diff -q "$file_bak" "$file"; then
      echo "No changes in '$file'\n"
      "$SUDO" cat "$file"
    else
      status=true
      "$SUDO" diff -y "$file_bak" "$file"
    fi
done

if "$status"; then
  "$SUDO" systemctl restart systemd-networkd
  # netplan apply
fi

#!/usr/bin/env bash

set -euo pipefail
#set -x

SUDO=sudo
[[ "$(whoami)" == "root" ]] && SUDO=""

mask='^(enp|wlp)'
mask_vpn='^(fctvpn)'
NETPLAN_DIR="/etc/netplan"
BAK_DIR="$NETPLAN_DIR/bak"
"$SUDO" mkdir -p "$BAK_DIR"
TIMEOUT=3

unique_array() {
  declare -A seen
  local item
  local -a out=()
  for item in "$@"; do
    if [[ -z "${seen[$item]:-}" ]]; then
      out+=("$item")
      seen[$item]=1
    fi
  done
  printf '%s\n' "${out[@]}"
}

declare -a active_devices
mapfile active_devices < <($SUDO nmcli -f device,uuid connection show --active | tail -n+2)
devices=()
uuids=()
status=false
#set -x
for file in "$NETPLAN_DIR"/*.yaml "$NETPLAN_DIR"/*.yml; do
    device="$("$SUDO" yq eval '.network.ethernets.*.match.name, .network.wifis.*.match.name' "$file" 2>/dev/null | grep -E "$mask" | head -1 || :)"
    [[ -z "$device" ]] && continue
    uuid="$(printf "%s\n" "${active_devices[@]}" | grep -Po "^${device}\s+\K(.*)$")"
    [[ -z $uuid ]] && continue

    devices+=("$device")
    uuids+=("$uuid")
    echo -e "\nProcessing: device $device from $file"

    file_bak="$BAK_DIR/$(basename "$file")"
    "$SUDO" rm -f "$file_bak"
    "$SUDO" cp "$file" "$file_bak"

    "$SUDO" yq eval 'del(
        .network.ethernets.*.nameservers,
        .network.ethernets.*.networkmanager.passthrough."ipv4.dns-search",
        .network.ethernets.*.networkmanager.passthrough."ipv4.ignore-auto-dns",
        .network.ethernets.*.networkmanager.passthrough."ipv6.ignore-auto-dns"
    )' -i "$file" 2>/dev/null

    if "$SUDO" diff -q "$file_bak" "$file"; then
      echo -e "No changes in $file"
#      "$SUDO" cat "$file"
    else
      status=true
      echo
      "$SUDO" diff -y "$file_bak" "$file" || :
    fi
done

devices=($(unique_array "${devices[@]}"))
uuids=($(unique_array "${uuids[@]}"))

echo -e "\n###########"

#####
$status && sleep $TIMEOUT
status=false
mapfile -t vpn_connections < <(nmcli -t connection show | grep -E $mask_vpn | cut -d: -f1)
for c in "${vpn_connections[@]}"; do
  status=true
  echo
  echo "$SUDO" nmcli connection delete "$c"
       "$SUDO" nmcli connection delete "$c" || :
done

#####
$status && sleep $TIMEOUT
status=false
for uuid in "${uuids[@]}"; do
  status=true
  echo
  echo "$SUDO" nmcli connection down "$uuid"
       "$SUDO" nmcli connection down "$uuid" || :
  sleep $TIMEOUT
  echo "$SUDO" nmcli connection up "$uuid"
       "$SUDO" nmcli connection up "$uuid" || :
done

exit 0


#####
$status && sleep $TIMEOUT
status=false
active=
for device in "${devices[@]}"; do
  uuid="$()"
  status=true
  echo
  echo "$SUDO" nmcli device reapply "$device"
       "$SUDO" nmcli device reapply "$device" || :
done

#####
$status && sleep $TIMEOUT
status=true
echo
echo "$SUDO" nmcli connection reload
     "$SUDO" nmcli connection reload || :

#####
$status && sleep $TIMEOUT
echo "$SUDO" systemctl restart systemd-networkd
     "$SUDO" systemctl restart systemd-networkd

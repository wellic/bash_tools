#!/usr/bin/env bash

# Print complete history entries, separated by NUL rather than newlines.
_clean_history_records() {
    local first=$1 last entry number

    # Preserve trailing newlines while removing history's number prefix.
    entry=$(HISTTIMEFORMAT= builtin history 1; printf .)
    entry=${entry%$'\n.'}
    [[ $entry =~ ^[[:blank:]]*([0-9]+)[\ *]\ (.*)$ ]] || return 2
    last=${BASH_REMATCH[1]}
    entry=${BASH_REMATCH[2]}

    # This function runs in a pipeline's subshell. Re-pushing the last entry
    # prevents interactive history -p from removing entries as it reads them.
    HISTSIZE=-1
    builtin history -s "$entry" || return 2
    for ((number=first; number<=last; number++)); do
        builtin history -p '!'"$number" || return 2
        printf '\0'
    done
}

# Preview and deletion share one search and one list of entry numbers.
_clean_history_run() {
    local re=$1 mode=$2 first rest row number reply index
    local -a rows=() numbers=() statuses=()
    shift 2

    IFS=' ' read -r first rest < <(HISTTIMEFORMAT= builtin history) || {
        printf 'History is empty.\n'
        return 0
    }
    first=${first%\*}

    # The last NUL-delimited result carries grep's status, so an error
    # cannot be mistaken for a successful search with no matches.
    mapfile -d '' -t rows < <(
        set +e
        _clean_history_records "$first" |
            command sed -z 's/\n$//' |
            command grep -znP "$@" -- "$re"
        statuses=("${PIPESTATUS[@]}")
        if (( statuses[0] || statuses[1] || statuses[2] > 1 )); then
            printf '2\0'
        else
            printf '%s\0' "${statuses[2]}"
        fi
    )
    if (( rows[-1] > 1 )); then
        printf 'Search failed; nothing deleted.\n' >&2
        return 1
    fi
    unset 'rows[-1]'

    if (( ${#rows[@]} == 0 )); then
        printf 'No matching history entries.\n'
        return 0
    fi
    for row in "${rows[@]}"; do
        number=$((first + ${row%%:*} - 1))
        numbers+=("$number")
        printf '%6d  %s\n' "$number" "${row#*:}"
    done

    [[ $mode == d ]] || return 0
    IFS= read -r -p 'Press Enter to delete; any text cancels: ' reply || return 1
    [[ -z $reply ]] || return 0
    for ((index=${#numbers[@]}-1; index>=0; index--)); do
        builtin history -d "${numbers[index]}" || return 1
    done
    builtin history -w || {
        printf 'Entries deleted from this session, but saving history failed.\n' >&2
        return 1
    }
    printf 'Removed and saved: %d entries.\n' "${#numbers[@]}"
}

_clean_history_main() {
    local re mode=v arg action path
    if (( $# == 0 )) || [[ $1 == --help ]]; then
        printf 'Usage: %s regexp [v|d] [-ivwx]\n' "${BASH_SOURCE[0]##*/}"
        printf '%s\n' 'Copy the printed source command into the Bash session to clean.'
        printf '%s\n' 'Search: grep -zP over whole entries; (?m) for line anchors, (?s) for newlines.'
        [[ ${1-} == --help ]]
        return
    fi
    re=$1
    shift
    if (( $# )) && [[ $1 == v || $1 == d ]]; then
        mode=$1
        shift
    fi
    for arg in "$@"; do
        case $arg in
            --ignore-case|--no-ignore-case|--invert-match|--word-regexp|--line-regexp) ;;
            *) [[ $arg =~ ^-[ivwx]+$ ]] || { printf 'Unsupported option: %s\n' "$arg" >&2; return 1; } ;;
        esac
    done
    command grep -zP "$@" -- "$re" </dev/null >/dev/null || [[ $? == 1 ]] || return 1

    if [[ ${BASH_SOURCE[0]} != "$0" ]]; then
        _clean_history_run "$re" "$mode" "$@"
        return
    fi

    path=$(readlink -f -- "${BASH_SOURCE[0]}") || return 1
    for action in v d; do
        [[ $action == v && $mode == d ]] && continue
        printf '\n# %s:\n' "$action"
        printf ' source %q %q %q' "$path" "$re" "$action"
        for arg in "$@"; do printf ' %q' "$arg"; done
        printf '\n'
    done
}

if _clean_history_main "$@"; then
    unset -f _clean_history_records _clean_history_run _clean_history_main
else
    unset -f _clean_history_records _clean_history_run _clean_history_main
    [[ ${BASH_SOURCE[0]} != "$0" ]] && return 1
    exit 1
fi
